<Window x:Class="ITDigitacao.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ITDigitacao.Wpf"
        Title="IT Digitação | Instituto de Transformação"
        Width="1440" Height="900" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BrandBackground}"
        FontFamily="{StaticResource BrandFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrandSurface}" BorderBrush="{StaticResource BrandBorder}"
                BorderThickness="0,0,0,1" Padding="28,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/IT-Digitacao-3.0;component/Assets/logo-instituto.png" Width="48" Height="48"
                       Stretch="UniformToFill" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock FontSize="25" FontWeight="Bold">
                        <Run Text="IT " Foreground="{StaticResource BrandRed}" /><Run Text="Digitação" Foreground="{StaticResource BrandInk}" />
                    </TextBlock>
                    <TextBlock Text="Instituto de Transformação" FontSize="13" Foreground="{StaticResource BrandMuted}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource HeaderActionButton}" Content="Como digitar"
                        Margin="8,0" Click="Guide_Click" ToolTip="Abrir o guia de digitação" />
                <TextBlock x:Name="GlobalClockLabel" Grid.Column="4" Text="20:00" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrandDeepRed}" VerticalAlignment="Center" Margin="8,0"
                           Visibility="Collapsed" AutomationProperties.Name="Tempo restante da sessão" />
                <Button Grid.Column="5" Style="{StaticResource HeaderActionButton}" Content="Configurações"
                        Margin="8,0" Click="Settings_Click" ToolTip="Abrir configurações" />
                <Button Grid.Column="6" Style="{StaticResource HeaderActionButton}" Content="Sair"
                        Margin="8,0,0,0" Click="Exit_Click" ToolTip="Fechar o IT Digitação" />
            </Grid>
        </Border>

        <Grid x:Name="PageArea" Grid.Row="1">
        <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid x:Name="HomeContent" Margin="28,20" SizeChanged="HomeContent_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="20" ClipToBounds="True" Padding="32,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#A60000" Offset="0" />
                            <GradientStop Color="#D90000" Offset="0.62" />
                            <GradientStop Color="#A60000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Canvas IsHitTestVisible="False" Opacity="0.11">
                            <Path Data="M 720,205 C 900,88 1010,100 1170,-35" Stroke="White" StrokeThickness="30" />
                            <Path Data="M 810,212 C 990,100 1090,118 1230,-20" Stroke="White" StrokeThickness="9" />
                            <Path Data="M 770,225 C 980,145 1100,156 1280,12" Stroke="#FF9C9C" StrokeThickness="5" />
                        </Canvas>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MaxWidth="760" Margin="0,0,8,0">
                                <TextBlock Text="SUA JORNADA DE APRENDIZADO" FontSize="12" FontWeight="Bold"
                                           Foreground="#FFFFD9D9" Margin="0,0,0,8" />
                                <TextBlock x:Name="HomeHeroTitle" Text="Vamos aprender algo incrível hoje?" FontSize="34" FontWeight="Bold"
                                           MaxWidth="610" Foreground="White" TextWrapping="Wrap" LineHeight="39" />
                                <TextBlock Text="Descubra novos conhecimentos enquanto desenvolve suas habilidades no teclado."
                                           FontSize="16" Foreground="#FFFFF4F4" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            <Image Grid.Column="1" Source="/IT-Digitacao-3.0;component/Assets/Mascot/boas-vindas.png"
                                   Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   MaxWidth="390" MaxHeight="180" Margin="0,0,0,-22" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="8,16,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/IT-Digitacao-3.0;component/Assets/Icons/relogio.png" Width="34" Height="34"
                           VerticalAlignment="Center" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Escolha seu tempo de prática" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandInk}" />
                        <TextBlock Text="Quanto tempo você tem disponível hoje?" FontSize="14" Foreground="{StaticResource BrandMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="DurationGrid" Grid.Row="2" Rows="1" Columns="6" Margin="0,0,0,0">
                    <Button Tag="5" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="False" AutomationProperties.Name="5 minutos" />
                    <Button Tag="10" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="False" AutomationProperties.Name="10 minutos" />
                    <Button Tag="15" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="False" AutomationProperties.Name="15 minutos" />
                    <Button Tag="20" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="True" AutomationProperties.Name="20 minutos" />
                    <Button Tag="25" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="False" AutomationProperties.Name="25 minutos" />
                    <Button Tag="30" Style="{StaticResource DurationButton}" Click="Duration_Click" local:DurationChoice.IsSelected="False" AutomationProperties.Name="30 minutos" />
                </UniformGrid>

                <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="▶   Começar minha aventura   →"
                        HorizontalAlignment="Center" MinWidth="360" Margin="0,18,0,14" Click="Start_Click" />

                <UniformGrid Grid.Row="4" x:Name="FeatureGrid" Rows="1" Columns="3" Margin="-6,0">
                    <Border Style="{StaticResource FeatureCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Source="/IT-Digitacao-3.0;component/Assets/Icons/biblioteca.png" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Aprenda" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandInk}" />
                                <TextBlock Text="Descubra conteúdos úteis e curiosos." FontSize="14" Foreground="{StaticResource BrandMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FeatureCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Source="/IT-Digitacao-3.0;component/Assets/Icons/teclado.png" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Pratique" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandInk}" />
                                <TextBlock Text="Melhore sua digitação de forma divertida." FontSize="14" Foreground="{StaticResource BrandMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FeatureCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Source="/IT-Digitacao-3.0;component/Assets/Icons/relogio.png" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Evolua" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandInk}" />
                                <TextBlock Text="Acompanhe seu progresso a cada desafio." FontSize="14" Foreground="{StaticResource BrandMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrandDeepRed}" Padding="28,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/IT-Digitacao-3.0;component/Assets/logo-instituto.png" Width="27" Height="27" Stretch="UniformToFill" />
                    <TextBlock Text="Instituto de Transformação" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◉" FontFamily="Segoe UI Symbol" Foreground="White" FontSize="18" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="#99FFFFFF" Margin="12,0" />
                    <TextBlock Text="Offline" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
